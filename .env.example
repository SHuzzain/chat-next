OPENAI_API_KEY=

# LMS backend used to verify the iframe bearer token.
LMS_BACKEND_URL=http://localhost:3101/v1/

# Allowed LMS origin for the iframe widget (server CSP + client postMessage).
LMS_FRONTEND_ORIGIN=http://localhost:3100
NEXT_PUBLIC_LMS_FRONTEND_ORIGIN=http://localhost:3100

# Agent audit Postgres only. Tables live in the lms-agent schema.
DB_NAME=lms_agent
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_SSL=disable
