# OpenAI: Eve embeddings + Realtime voice (POST /api/realtime SDP exchange).
# Voice LMS tools: browser → POST /api/voice/tool → Eve Client → existing tools.
OPENAI_API_KEY=

# Must match next.config.ts basePath (Apache mounts the app at /agent/)
NEXT_PUBLIC_BASE_PATH=/agent

# LMS backend used to verify the iframe bearer token.
LMS_BACKEND_URL=http://localhost:3101/v1/

# Eve tools call this Next origin to take form secrets (password/avatar)
# and load privilege capabilities (Next unstable_cache).
# Must reach the same process that handled POST /api/agent/secrets.
LMS_AGENT_INTERNAL_URL=http://127.0.0.1:3607

# Next Data Cache revalidate (seconds) for GET /api/privileges/capabilities.
# Tags: lms-privileges:{credentialId}
LMS_PRIVILEGE_CACHE_TTL_SEC=300

# Allowed LMS origin for the iframe widget (server CSP + client postMessage).
LMS_FRONTEND_ORIGIN=http://localhost:3100
NEXT_PUBLIC_LMS_FRONTEND_ORIGIN=http://localhost:3100

# Agent audit Postgres + MindChamps RAG (public.embedding_document).
# If Postgres runs on the same host as the agent, use 127.0.0.1 (not the public IP).
DB_NAME=lms_agent
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_SSL=disable

# Optional: how many RAG hits to return (default 8, max 20).
# RAG_TOP_K=8
