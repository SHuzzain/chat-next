    "pm2:restart": "pnpm exec pm2 restart ecosystem.config.js",
    "pm2:reload": "pnpm exec pm2 reload ecosystem.config.js",
    "pm2:delete": "pnpm exec pm2 delete ecosystem.config.js",
    "pm2:logs": "pnpm exec pm2 logs chatbot-next",
    "pm2:status": "pnpm exec pm2 status",
    "pm2:save": "pnpm exec pm2 save",
    "deploy:prod": "pnpm build && pnpm exec pm2 startOrRestart ecosystem.config.js"
  },
