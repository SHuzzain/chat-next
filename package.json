{
  "name": "chatbot-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3606",
    "build": "next build",
    "start": "next start -p 3606",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "pm2:start": "pnpm exec pm2 start ecosystem.config.js",
